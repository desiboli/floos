{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@floos/ai": "workspace:*",
    "@floos/auth": "workspace:*",
    "@floos/banking": "workspace:*",
    "@floos/db": "workspace:*",
    "@floos/env": "workspace:*",
    "@floos/jobs": "workspace:*",
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.11.16",
    "@trigger.dev/sdk": "^4.5.12",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "^2.22.4",
    "hono": "^4.12.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@floos/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
